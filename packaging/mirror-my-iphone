#!/bin/bash
# mirror-my-iphone — command-line companion of Mirror my iPhone (link it into your PATH, see README).
# Runs cli.py from the app bundle with the app's Python environment. See: mirror-my-iphone --help
set -euo pipefail

# Follow a symlink (e.g. from /usr/local/bin) back into the app bundle
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
    DIR="$(cd "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ "$SELF" != /* ]] && SELF="$DIR/$SELF"
done
RESOURCES="$(cd "$(dirname "$SELF")/.." && pwd)"
# The same, only environment as the app's launcher (launcher.c)
VENV="$HOME/Library/Application Support/Mirror my iPhone/venv"
if ! { [ -x "$VENV/bin/python3" ] && cmp -s "$RESOURCES/app/requirements.lock" "$VENV/.requirements.lock"; }; then
    "$RESOURCES/bootstrap.sh" >&2
fi
exec "$VENV/bin/python3" "$RESOURCES/app/cli.py" "$@"
